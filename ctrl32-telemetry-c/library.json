{
  "name": "ctrl32-telemetry",
  "version": "0.1.0",
  "description": "Device library for ctrl32 telemetry: MQTT telemetry with offline buffer, commands with ack, shared attributes, remote console and FOTA (protocol v0.1).",
  "keywords": "telemetry, mqtt, iot, fota, esp32, ctrl32",
  "repository": { "type": "git", "url": "https://github.com/telemetry-digital/ctrl32-telemetry-c" },
  "license": "Apache-2.0",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "dependencies": [ { "owner": "knolleary", "name": "PubSubClient", "version": "^2.8" } ],
  "build": {
    "srcDir": ".",
    "srcFilter": ["+<src/*.c>", "+<ports/arduino/*.cpp>"],
    "includeDir": "src",
    "flags": ["-Iports/arduino"]
  },
  "export": { "include": ["src", "ports/arduino", "examples/arduino", "LICENSE", "README.md", "library.properties", "library.json"] }
}
