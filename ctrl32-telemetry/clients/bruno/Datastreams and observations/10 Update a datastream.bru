meta {
  name: Update a datastream
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/datastreams/:id
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "accuracy": 21.5,
    "expected_interval": "string",
    "quantity": "string",
    "range": {
      "max": 21.5,
      "min": 21.5
    },
    "reason": "string",
    "unit": "string"
  }
}

docs {
  Update a datastream
  
  `range` replaces the physical range (a null bound removes it); without `range` the range stays.
  
  Requires permission `config.write`.
}
