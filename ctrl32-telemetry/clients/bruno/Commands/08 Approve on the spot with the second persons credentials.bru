  url: {{baseUrl}}/api/v1/second-person/approve
  body: json
  auth: inherit
}

body:json {
  {
    "code": "string",
    "device_id": "018f5c2a-1b7e-7c3d-9a41-3f2e6b8d1c00",
    "id": "018f5c2a-1b7e-7c3d-9a41-3f2e6b8d1c00",
