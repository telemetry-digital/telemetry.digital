meta {
  name: Set the backup schedule
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/server/backups/schedule
  body: json
  auth: inherit
}

body:json {
  {
    "enabled": true,
    "hour": 1,
    "keep": 1,
    "minute": 1,
    "passphrase": "string",
    "reason": "string"
  }
}

docs {
  Set the backup schedule
  
  Requires permission `system.admin`.
}
