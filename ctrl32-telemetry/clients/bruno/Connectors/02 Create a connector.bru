meta {
  name: Create a connector
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/connectors
  body: json
  auth: inherit
}

body:json {
  {
    "auto_create_devices": true,
    "kind": "chirpstack",
    "name": "string",
    "reason": "string",
    "settings": {
      "auth": "string",
      "byte_order": "big",
      "device_external_id": "string",
      "endpoint": "string",
      "framing": "tcp",
      "host": "string",
      "interval_s": 1,
      "nodes": [
        {}
      ],
      "password": "string",
      "port": 1,
      "profile_id": "string",
      "profile_name": "string",
      "profile_version": 1,
      "registers": [
        {
          "address": 1,
          "key": "string",
          "max": 21.5,
          "min": 21.5,
          "offset": 21.5,
          "scale": 21.5,
          "table": "holding",
          "type": "bool",
          "writable": true
        }
      ],
      "security_mode": "string",
      "security_policy": "string",
      "timeout_ms": 1,
      "unit_id": 1,
      "username": "string"
    }
  }
}

docs {
  Create a connector
  
  `kind` chirpstack: returns the ingest URL and a bearer secret (shown once) for the ChirpStack HTTP integration. `kind` opcua / modbus_tcp: `settings` describe the endpoint and the nodes/registers; values arrive under a virtual device (`settings.device_external_id`).
  
  Requires permission `config.write`.
}
