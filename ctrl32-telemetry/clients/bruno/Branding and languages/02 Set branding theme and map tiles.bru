meta {
  name: Set branding theme and map tiles
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/branding
  body: json
  auth: inherit
}

body:json {
  {
    "clear_logo": true,
    "logo": {
      "data": "string",
      "mime": "string"
    },
    "map": {
      "attribution": "string",
      "builtin": true,
      "center_lat": 21.5,
      "center_lon": 21.5,
      "local": true,
      "max_zoom": 1,
      "source": "string",
      "tile_url": "string",
      "zoom": 1
    },
    "reason": "string",
    "theme": {
      "font": "string",
      "font_scale": "small",
      "mode": "auto",
      "primary": "string",
      "radius": "none"
    },
    "white_label": {
      "clear_icon": true,
      "enabled": true,
      "footer_links": [
        {
          "label": "string",
          "url": "string"
        }
      ],
      "footer_text": "string",
      "icon": {
        "data": "string",
        "mime": "string"
      },
      "intro": "string",
      "product_name": "string",
      "short_name": "string",
      "show_version": true
    }
  }
}

docs {
  Set branding, theme and map tiles
  
  Logo as base64 (PNG/SVG/JPEG, max 256 KiB).
  
  Requires permission `content.write`.
}
