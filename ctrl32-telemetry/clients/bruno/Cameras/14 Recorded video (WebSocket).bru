  name: Recorded video (WebSocket)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/video/cameras/:id/playback
  body: none
  auth: inherit
}

params:path {
  id: 
}

params:query {
  ~audio: 
