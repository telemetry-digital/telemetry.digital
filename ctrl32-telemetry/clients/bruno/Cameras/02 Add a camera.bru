meta {
  name: Add a camera
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/video/cameras
  body: json
  auth: inherit
}

body:json {
  {
    "enabled": true,
    "location": "string",
    "name": "string",
    "password": "string",
    "reason": "string",
    "record": "continuous",
    "retention_days": 1,
    "sort": 1,
    "sub_url": "string",
    "transport": "auto",
    "url": "string",
    "username": "string"
  }
}

docs {
  Add a camera
  
  Requires permission `video.manage`.
}
