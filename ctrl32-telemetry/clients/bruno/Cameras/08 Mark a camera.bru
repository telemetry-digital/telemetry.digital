meta {
  name: Mark a camera
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/video/cameras/:id/events
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "label": "string",
    "seconds": 1
  }
}

docs {
  Mark a camera
  
  A mark on the timeline; on a camera recording on events it records the given seconds with the pre-roll before. Audited.
  
  Requires permission `video.view`.
}
