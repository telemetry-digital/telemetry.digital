meta {
  name: Update a site
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/sites/:id
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "address": "string",
    "clear_location": true,
    "location": {
      "lat": 21.5,
      "lon": 21.5
    },
    "name": "string",
    "reason": "string",
    "tz": "string"
  }
}

docs {
  Update a site
  
  `location` sets the map position of the site (kept in its attributes as lat, lon); `clear_location` removes it.
  
  Requires permission `config.write`.
}
